# MERCADO PAGO — Link de Pagamento (Forma mais simples)
# 
# 1. Abra o app Mercado Pago > "Cobrar" > informe valor R$ 97
# 2. Copie o link gerado (ex: https://mpago.la/XXXXX)
# 3. Cole abaixo:
NEXT_PUBLIC_MERCADO_PAGO_LINK=https://mpago.la/SEU_LINK_AQUI

# Se quiser usar o SDK no futuro (precisa remover output:'export' do next.config.mjs):
# MERCADO_PAGO_ACCESS_TOKEN=APP_USB-XXXXXXXXX
# MERCADO_PAGO_PUBLIC_KEY=APP_USb-XXXXXXXXX
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
